---
import Base from '../layouts/Base.astro';

const title = 'Cyrus B. Ravandi — AI for scientific discovery';
const description =
  'Data & AI product strategy leader in biopharma research and translational science. Twelve years of computational work, five building AI capability inside R&D.';

const work = [
  {
    kicker: 'Enterprise strategy',
    years: '2024 — today',
    title: 'Scientific intelligence, measured by decisions',
    body: 'Defined the enterprise product strategy that moved R&D AI evaluation off usage dashboards and onto research impact, decision quality, and value. The decision framework it produced now guides AI investment, platform, and vendor priorities.',
    tags: ['Product vision', 'Roadmap', 'AI governance', 'Value measurement'],
  },
  {
    kicker: 'Translational AI',
    years: '2023 — 2026',
    title: 'Rare disease borrows from common biology',
    body: 'Built a translational strategy that used shared mechanism to work around sparse rare-disease data, integrating biological, clinical, and real-world evidence. Applied across seven assets to prioritize repurposing and indication expansion.',
    tags: ['Dis2Vec', 'Knowledge graphs', 'Indication strategy'],
  },
  {
    kicker: 'Evaluation',
    years: '2023 — today',
    title: 'Benchmark-first, or it does not ship',
    body: 'Grounded model and vendor assessment in biological evidence and real clinical-trial decisions rather than leaderboard scores — five vendors evaluated, two academic partnerships established, including Orphanet and the European Reference Networks.',
    tags: ['Benchmarking', 'Vendor strategy', 'Generalizability'],
  },
];

const stats = [
  { n: '12+', l: 'Years across computational science, data, and AI' },
  { n: '3', l: 'AI products delivered and adopted in R&D' },
  { n: '20', l: 'Peer-reviewed publications, 500+ citations' },
  { n: '30k', l: 'Rare-disease experts reached via Orphanet & ERN' },
];

const journals = ['Nature Communications', 'Nature Food', 'PNAS', 'Bioinformatics'];

const pubs = [
  { year: '2026', cite: 'Ravandi, C. B., et al. (2026). Clinical trial and ontology-derived positive and negative benchmark datasets for drug repurposing across rare diseases.', venue: 'Scientific Data', tail: ' (in review).', tag: 'In review', href: 'https://doi.org/10.64898/2026.06.15.732135', link: 'doi.org/10.64898/2026.06.15.732135' },
  { year: '2026', cite: 'Ravandi, C. B., et al. (2026). A mechanistic disease representation framework for therapeutic knowledge transfer across rare and common conditions.', venue: 'bioRxiv', tail: ', 2024.11.19.624381.', tag: 'Preprint', href: 'https://doi.org/10.1101/2024.11.19.624381', link: 'doi.org/10.1101/2024.11.19.624381' },
  { year: '2025', cite: 'Ravandi, C. B., et al. (2025). Topology-driven negative sampling enhances generalizability in protein–protein interaction prediction.', venue: 'Bioinformatics', tail: ', btaf148.', tag: 'Bioinformatics', href: 'https://doi.org/10.1093/bioinformatics/btaf148', link: 'doi.org/10.1093/bioinformatics/btaf148' },
  { year: '2025', cite: 'Chatterjee, A., Ikica, B., Ravandi, C. B., et al. (2025). Transfer learning for temporal link prediction.', venue: 'International Joint Conference on Neural Networks (IJCNN)', tail: ', 1–8.', tag: 'IEEE IJCNN 2025', href: 'https://doi.org/10.1109/IJCNN64981.2025.11228624', link: 'doi.org/10.1109/IJCNN64981.2025.11228624' },
  { year: '2025', cite: 'Ravandi, C. B., et al. (2025). Prevalence of processed foods in major US grocery stores.', venue: 'Nature Food', tail: '.', tag: 'Nature Food', href: 'https://rdcu.be/d55mU', link: 'rdcu.be/d55mU' },
  { year: '2024', cite: 'Nabizadeh, M., Nasirian, F., … Ravandi, C. B., et al. (2024). Network physics of attractive colloidal gels: Resilience, rigidity, and phase diagram.', venue: 'Proceedings of the National Academy of Sciences', tail: '.', tag: 'PNAS', href: 'https://doi.org/10.1073/pnas.2316394121', link: 'doi.org/10.1073/pnas.2316394121' },
  { year: '2023', cite: 'Menichetti, G., Ravandi, C. B., et al. (2023). Machine learning prediction of the degree of food processing.', venue: 'Nature Communications', tail: ', 14, 2312.', tag: 'Nature Communications', href: 'https://doi.org/10.1038/s41467-023-37457-1', link: 'doi.org/10.1038/s41467-023-37457-1' },
  { year: '2019', cite: 'Ravandi, C. B., et al. (2019). Impact of plate size on food waste: Agent-based simulation of food consumption.', venue: 'Resources, Conservation and Recycling', tail: '.', tag: 'Elsevier', href: 'https://doi.org/10.1016/j.resconrec.2019.05.033', link: 'doi.org/10.1016/j.resconrec.2019.05.033' },
  { year: '2018', cite: 'Ravandi, C. B., et al. (2018). A self-organized resource provisioning for cloud block storage.', venue: 'Future Generation Computer Systems', tail: '.', tag: 'Elsevier', href: 'https://doi.org/10.1016/j.future.2018.06.045', link: 'doi.org/10.1016/j.future.2018.06.045' },
];
---

<Base title={title} description={description}>
  <div class="shell">
    <div class="col">
      <header class="site-header">
        <div class="brand">
          <span class="brand-dot" aria-hidden="true"></span>
          <span class="brand-name">CYRUS B. RAVANDI</span>
        </div>
        <nav class="site-nav">
          <a href="#work">Work</a>
          <a href="#track">Track record</a>
          <a href="#publications">Publications</a>
          <a href="#contact">Contact</a>
        </nav>
      </header>

      <section class="hero">
        <div class="hero-top">
          <div class="avatar">
            <img src="/images/cyrus-headshot.jpg" alt="Cyrus B. Ravandi" width="496" height="496" />
          </div>
          <div class="badge">
            <span class="badge-dot" aria-hidden="true"></span>
            Boston, MA · Advising &amp; speaking
          </div>
        </div>
        <h1>I turn scientific ambition<br />into AI that earns its place.</h1>
        <p class="lede">
          Data &amp; AI product strategy leader in biopharma research and translational science. Twelve years of
          computational work, five of them building AI capability inside R&amp;D — where the measure of a model is
          not adoption, but a better decision made sooner.
        </p>
        <p class="quote">&ldquo;Discover with Purpose.&rdquo;</p>

        <div class="cta-row">
          <a class="lf-btn lf-btn--primary lf-btn--lg" href="https://www.linkedin.com/in/CyrusRavandi" target="_blank" rel="noopener">
            Follow on LinkedIn
          </a>
          <a class="lf-btn lf-btn--secondary lf-btn--lg" href="mailto:cyrus@ravandi.ai"> cyrus@ravandi.ai </a>
        </div>
      </section>

      <section id="work" class="section">
        <div class="section-head">
          <span class="step-num">01</span>
          <h2>Selected work</h2>
        </div>
        <div class="work-grid">
          {work.map((w) => (
            <article class="work-card">
              <div class="work-card__top">
                <span class="kicker">{w.kicker}</span>
                <span class="years">{w.years}</span>
              </div>
              <h3>{w.title}</h3>
              <p>{w.body}</p>
              <div class="tags">
                {w.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="track" class="section">
        <div class="section-head">
          <span class="step-num">02</span>
          <h2>Track record</h2>
        </div>
        <div class="stats-grid">
          {stats.map((s) => (
            <div class="stat">
              <div class="stat__n">{s.n}</div>
              <div class="stat__l">{s.l}</div>
            </div>
          ))}
        </div>

        <p class="journals-label">Published in</p>
        <div class="journals">
          {journals.map((j) => (
            <span class="journal">{j}</span>
          ))}
        </div>
      </section>

      <section id="publications" class="section">
        <div class="section-head section-head--tight">
          <span class="step-num">03</span>
          <h2>Publications</h2>
        </div>
        <p class="pubs-intro">
          Twenty peer-reviewed papers and preprints on generalizability, negative sampling, disease representation,
          and measurement in biological machine learning — 500+ citations. Recent work:
        </p>
        <ol class="pubs-list">
          {pubs.map((p) => (
            <li class="pub">
              <span class="pub__year">{p.year}</span>
              <div>
                <p class="pub__cite">
                  {p.cite} <em>{p.venue}</em>{p.tail}
                </p>
                <div class="pub__meta">
                  <span class="pub__tag">{p.tag}</span>
                  <a class="pub__link" href={p.href} target="_blank" rel="noopener">
                    {p.link}
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ol>
        <p class="pubs-more">
          Full list on <a href="https://scholar.google.com" target="_blank" rel="noopener">Google Scholar</a>.
        </p>
      </section>

      <section id="contact" class="section section--last">
        <div class="contact-card">
          <h2>If you are deciding where AI belongs in your research organization, I am glad to think it through with you.</h2>
          <p>Advisory, board conversations, and talks. Boston-based, working globally.</p>
          <div class="cta-row">
            <a class="lf-btn lf-btn--primary lf-btn--lg" href="https://www.linkedin.com/in/CyrusRavandi" target="_blank" rel="noopener">
              Follow on LinkedIn
            </a>
            <a class="lf-btn lf-btn--ghost lf-btn--lg" href="mailto:cyrus@ravandi.ai">Email me</a>
          </div>
        </div>
        <div class="footer-row">
          <span>© 2026 Cyrus B. Ravandi, Ph.D.</span>
          <span class="footer-links">
            <a href="https://scholar.google.com" target="_blank" rel="noopener">Google Scholar</a>
            <a href="https://github.com/bravandi" target="_blank" rel="noopener">GitHub</a>
            <a href="https://www.linkedin.com/in/CyrusRavandi" target="_blank" rel="noopener">LinkedIn</a>
          </span>
        </div>
      </section>
    </div>

    <aside class="stage-aside" id="stage-aside">
      <story-stage controls theme="light" count="280" hold="3400"></story-stage>
    </aside>
  </div>
</Base>

<script src="../scripts/emergence-story.js"></script>
<script>
  const col = document.querySelector('.col');
  const aside = document.getElementById('stage-aside');
  if (col && aside) {
    aside.addEventListener(
      'wheel',
      (e) => {
        if (!e.deltaY) return;
        e.preventDefault();
        col.scrollTop += e.deltaY;
      },
      { passive: false },
    );
  }
</script>

<style>
  .shell {
    height: 100vh;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    background: var(--white);
    color: var(--text-body);
  }

  .col {
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0 clamp(28px, 5vw, 76px);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 26px 0 0;
    position: sticky;
    top: 0;
    background: linear-gradient(var(--white) 72%, rgba(255, 255, 255, 0));
    z-index: 5;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 20px;
  }

  .brand-dot {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--gradient-brand);
  }

  .brand-name {
    font-size: 13px;
    font-weight: var(--fw-demibold);
    letter-spacing: 0.04em;
    color: var(--text-strong);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 22px;
    padding-bottom: 20px;
    font-size: 13px;
    color: var(--ink-600);
  }

  .site-nav a {
    color: inherit;
  }

  .hero {
    padding: clamp(40px, 7vh, 84px) 0 0;
  }

  .hero-top {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .avatar {
    position: relative;
    width: 104px;
    height: 104px;
    flex: none;
    border-radius: 50%;
    background: var(--gradient-soft);
    border: 1px solid var(--violet-100);
    box-shadow: 0 10px 26px rgba(109, 40, 217, 0.1);
    overflow: hidden;
  }

  .avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 8px;
    border: 1px solid var(--ink-200);
    border-radius: 999px;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-600);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--magenta-500);
  }

  h1 {
    margin: 22px 0 0;
    font-size: clamp(30px, 3.5vw, 46px);
    line-height: 1.12;
    letter-spacing: -0.028em;
    font-weight: var(--fw-extrabold);
    color: var(--ink-950);
    text-wrap: balance;
  }

  .lede {
    margin: 24px 0 0;
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.62;
    color: var(--text-body);
    max-width: 30em;
    text-wrap: pretty;
  }

  .quote {
    margin: 18px 0 0;
    font-size: 17px;
    font-weight: var(--fw-demibold);
    color: var(--violet-700);
    font-style: italic;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin: 32px 0 0;
  }

  .section {
    padding: clamp(64px, 10vh, 110px) 0 0;
  }

  .section--last {
    padding-bottom: clamp(48px, 8vh, 90px);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 30px;
  }

  .section-head--tight {
    margin-bottom: 12px;
  }

  .step-num {
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-400);
    font-variant-numeric: tabular-nums;
  }

  .section-head h2 {
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: var(--fw-bold);
    color: var(--text-strong);
  }

  .work-grid {
    display: grid;
    gap: 16px;
  }

  .work-card {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 24px;
    background: var(--white);
    box-shadow: 0 1px 2px rgba(20, 16, 31, 0.03);
    transition: transform 200ms var(--ease-out), box-shadow 200ms var(--ease-out), border-color 200ms;
  }

  .work-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 34px rgba(109, 40, 217, 0.1);
    border-color: var(--violet-200);
  }

  .work-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .kicker {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--violet-700);
    font-weight: var(--fw-bold);
  }

  .years {
    font-size: 11.5px;
    color: var(--ink-400);
    font-variant-numeric: tabular-nums;
  }

  .work-card h3 {
    margin: 12px 0 0;
    font-size: 21px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    font-weight: var(--fw-bold);
    color: var(--ink-950);
  }

  .work-card p {
    margin: 10px 0 0;
    font-size: 15px;
    line-height: 1.62;
    color: var(--text-body);
    text-wrap: pretty;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 0;
  }

  .tag {
    font-size: 11.5px;
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--violet-50);
    color: var(--violet-800);
    border: 1px solid var(--violet-100);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }

  .stat {
    background: var(--white);
    padding: 22px 20px;
  }

  .stat__n {
    font-size: 30px;
    font-weight: var(--fw-extrabold);
    letter-spacing: -0.02em;
    color: var(--ink-950);
    font-variant-numeric: tabular-nums;
  }

  .stat__l {
    margin-top: 6px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-600);
  }

  .journals-label {
    margin: 34px 0 14px;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-400);
  }

  .journals {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 15px;
    color: var(--text-strong);
  }

  .journal {
    font-weight: var(--fw-demibold);
  }

  .pubs-intro {
    margin: 0 0 30px;
    font-size: 15px;
    line-height: 1.62;
    color: var(--ink-600);
    max-width: 40em;
    text-wrap: pretty;
  }

  .pubs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .pub {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    gap: 20px;
    padding: 22px 6px;
    border-bottom: 1px solid var(--border);
    align-items: start;
  }

  .pub__year {
    font-size: 12.5px;
    color: var(--ink-400);
    font-variant-numeric: tabular-nums;
    padding-top: 3px;
  }

  .pub__cite {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-body);
    text-wrap: pretty;
  }

  .pub__cite em {
    color: var(--text-strong);
    font-style: normal;
  }

  .pub__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
  }

  .pub__tag {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: var(--fw-bold);
    color: var(--violet-700);
    padding: 4px 9px;
    border-radius: 6px;
    background: var(--violet-50);
  }

  .pub__link {
    font-size: 13px;
    color: var(--ink-500);
    border-bottom: 1px solid var(--border);
  }

  .pub__link:hover {
    color: var(--violet-700);
    border-color: var(--violet-300);
  }

  .pubs-more {
    margin: 22px 0 0;
    font-size: 14px;
    color: var(--text-muted);
  }

  .pubs-more a {
    color: var(--violet-700);
  }

  .contact-card {
    border-radius: 20px;
    padding: 34px;
    background: var(--gradient-soft);
    border: 1px solid var(--violet-100);
  }

  .contact-card h2 {
    margin: 0;
    font-size: clamp(24px, 2.2vw, 30px);
    line-height: 1.24;
    letter-spacing: -0.02em;
    font-weight: var(--fw-extrabold);
    color: var(--ink-950);
    max-width: 24em;
    text-wrap: pretty;
  }

  .contact-card p {
    margin: 14px 0 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--text-body);
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    justify-content: space-between;
    margin-top: 26px;
    font-size: 12.5px;
    color: var(--ink-400);
  }

  .footer-links {
    display: flex;
    gap: 16px;
  }

  .footer-links a {
    color: var(--ink-500);
  }

  .stage-aside {
    position: relative;
    border-left: 1px solid var(--border);
    background: var(--ink-50);
    overflow: hidden;
  }

  .stage-aside::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 55% at 60% 15%, rgba(139, 92, 246, 0.1) 0%, transparent 70%);
  }

  story-stage {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The canvas was authored as a fixed 1440×900 two-column preview; below that
     it degrades to a single scrolling column with the stage as a shorter
     banner rather than a full-height sidebar. */
  @media (max-width: 860px) {
    .shell {
      height: auto;
      display: flex;
      flex-direction: column;
    }

    /* Flatten .col so its sections become direct flex items of .shell —
       lets the stage slot in right after the hero via `order`, instead of
       always trailing at the very end of the page behind the footer. */
    .col {
      display: contents;
    }

    .site-header,
    .hero,
    .section {
      padding-inline: 20px;
    }

    .site-header { order: 0; }
    .hero { order: 1; }

    .stage-aside {
      order: 2;
      height: 60vh;
      border-left: none;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    #work { order: 3; }
    #track { order: 4; }
    #publications { order: 5; }
    #contact { order: 6; }

    .site-header {
      flex-wrap: wrap;
      row-gap: 10px;
    }

    .site-nav {
      gap: 14px;
      flex-wrap: wrap;
    }
  }
</style>

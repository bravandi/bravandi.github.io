---
import Base from '../layouts/Base.astro';

const title = 'Cyrus B. Ravandi — Turning AI strategy into scientific adoption';
const description =
  'Most AI in biopharma research stalls between capability and use. I close that gap by connecting scientific priorities, data, technology, products, and the people accountable for decisions, so AI becomes something researchers trust and reach for.';

// How the work is framed. Authority here comes from the point of view, so
// these lead the page — before any evidence of what was built.
const pov = [
  {
    t: 'Adoption is the hard part, not the model.',
    b: 'The capability usually already exists. What is missing is the path from a scientific question to a system a researcher trusts enough to act on — and that path runs through data, product, and organization, not through the architecture.',
  },
  {
    t: 'Measure decisions, not usage.',
    b: 'Dashboards count logins. The question worth answering is whether a decision was better, or arrived sooner, than it would have without the system. Everything downstream — investment, platform, partnership — gets easier once that is the standard.',
  },
  {
    t: 'Trust is earned on evidence scientists already accept.',
    b: 'Biological grounding and real clinical-trial decisions make a far better benchmark than a leaderboard score. A model that generalizes on paper and fails on the assets in front of you was never evaluated honestly.',
  },
  {
    t: 'The org chart is part of the architecture.',
    b: 'Where a capability sits, who owns the data, and who is accountable for the decision it informs shape outcomes more than model choice does. Getting that arrangement wrong is the most common reason good work stalls.',
  },
];

const work = [
  {
    kicker: 'Capability building',
    years: '0 → 1',
    title: 'Capability compounds where pilots do not',
    body: 'Stood up a dedicated AI team inside R&D and the operating model around it — how work gets selected, how scientists are brought in early, how delivery is judged. The output was never a set of projects; it was a capability the organization keeps using.',
    tags: ['Team building', 'Operating model', 'Cross-functional leadership'],
  },
  {
    kicker: 'Enterprise strategy',
    years: '2024 — today',
    title: 'Scientific intelligence, measured by decisions',
    body: 'Defined the enterprise product strategy that moved R&D AI evaluation off usage dashboards and onto research impact, decision quality, and value. The decision framework it produced now guides AI investment, platform, and vendor priorities.',
    tags: ['Product vision', 'Roadmap', 'AI governance', 'Value measurement'],
  },
  {
    kicker: 'Products in use',
    years: '2023 — 2026',
    title: 'Rare disease borrows from common biology',
    body: 'Built a translational strategy that used shared mechanism to work around sparse rare-disease data, integrating biological, clinical, and real-world evidence. Delivered as products scientists use, and applied across seven assets to prioritize repurposing and indication expansion.',
    tags: ['Dis2Vec', 'Knowledge graphs', 'Indication strategy'],
  },
  {
    kicker: 'Technology & partnerships',
    years: '2023 — today',
    title: 'Benchmark-first, or it does not ship',
    body: 'Grounded model and vendor assessment in biological evidence and real clinical-trial decisions rather than leaderboard scores — five external technologies evaluated, two academic partnerships established, including Orphanet and the European Reference Networks.',
    tags: ['Benchmarking', 'Vendor strategy', 'Generalizability'],
  },
];

const stats = [
  { n: '3', l: 'AI and data products adopted inside R&D' },
  { n: '7', l: 'Drug assets informed by translational AI strategy' },
  { n: '30k', l: 'Rare-disease experts reached via Orphanet & ERN' },
  { n: '20', l: 'Peer-reviewed publications, 500+ citations' },
];

const journals = ['Nature Communications', 'Nature Food', 'PNAS', 'Bioinformatics'];

// Selected, not complete — the papers that explain the standards the products
// are held to. The full list lives on Scholar.
const pubs = [
  { year: '2026', cite: 'Ravandi, C. B., et al. (2026). Clinical trial and ontology-derived positive and negative benchmark datasets for drug repurposing across rare diseases.', venue: 'Scientific Data', tail: ' (in review).', tag: 'In review', href: 'https://doi.org/10.64898/2026.06.15.732135', link: 'doi.org/10.64898/2026.06.15.732135' },
  { year: '2026', cite: 'Ravandi, C. B., et al. (2026). A mechanistic disease representation framework for therapeutic knowledge transfer across rare and common conditions.', venue: 'bioRxiv', tail: ', 2024.11.19.624381.', tag: 'Preprint', href: 'https://doi.org/10.1101/2024.11.19.624381', link: 'doi.org/10.1101/2024.11.19.624381' },
  { year: '2025', cite: 'Ravandi, C. B., et al. (2025). Topology-driven negative sampling enhances generalizability in protein–protein interaction prediction.', venue: 'Bioinformatics', tail: ', btaf148.', tag: 'Bioinformatics', href: 'https://doi.org/10.1093/bioinformatics/btaf148', link: 'doi.org/10.1093/bioinformatics/btaf148' },
  { year: '2025', cite: 'Ravandi, C. B., et al. (2025). Prevalence of processed foods in major US grocery stores.', venue: 'Nature Food', tail: '.', tag: 'Nature Food', href: 'https://rdcu.be/d55mU', link: 'rdcu.be/d55mU' },
  { year: '2023', cite: 'Menichetti, G., Ravandi, C. B., et al. (2023). Machine learning prediction of the degree of food processing.', venue: 'Nature Communications', tail: ', 14, 2312.', tag: 'Nature Communications', href: 'https://doi.org/10.1038/s41467-023-37457-1', link: 'doi.org/10.1038/s41467-023-37457-1' },
];
---

<Base title={title} description={description}>
  <div class="shell">
    <div class="col">
      <header class="site-header">
        <div class="brand">
          <span class="brand-dot" aria-hidden="true"></span>
          <span class="brand-name">CYRUS B. RAVANDI</span>
        </div>
        <nav class="site-nav">
          <a href="#view">Point of view</a>
          <a href="#work">Work</a>
          <a href="#evidence">Evidence</a>
          <a href="#contact">Contact</a>
        </nav>
      </header>

      <section class="hero">
        <div class="hero-top">
          <div class="avatar">
            <img src="/images/cyrus-headshot.jpg" alt="Cyrus B. Ravandi" width="496" height="496" />
          </div>
          <div class="badge">
            <span class="badge-dot" aria-hidden="true"></span>
            Boston, MA · AI in biopharma R&amp;D
          </div>
        </div>
        <h1>Turning AI strategy into <span class="grad-text">scientific adoption</span>.</h1>
        <p class="lede">
          Most AI in biopharma research stalls between capability and use. I close that gap by connecting scientific priorities, data, technology, products, and the people accountable for decisions, so AI becomes something researchers trust and reach for.
        </p>
        <div class="cta">
          <a class="lf-btn lf-btn--primary lf-btn--lg" href="https://www.linkedin.com/in/CyrusRavandi" target="_blank" rel="noopener">
            Follow on LinkedIn
          </a>
          <a class="lf-btn lf-btn--secondary lf-btn--lg" href="mailto:cyrus@ravandi.ai"> cyrus@ravandi.ai </a>
        </div>
      </section>

      <aside class="stage-panel">
        <story-stage
          controls
          theme="light"
          count="280"
          speed="0.7"
          hold="4900"
          mouse-radius="0.11"
          mouse-force="0.045"
          wiggle="1.3"
        ></story-stage>
      </aside>

      <section id="view" class="section">
        <div class="section-head section-head--tight">
          <span class="step-num">01</span>
          <h2>Point of view</h2>
        </div>
        <p class="section-intro">
          Four things I have come to believe about making AI matter inside a research organization.
        </p>
        <ol class="pov-list">
          {pov.map((p, i) => (
            <li class="pov" data-rise="0">
              <span class="pov__n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="pov__t">{p.t}</p>
                <p class="pov__b">{p.b}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="work" class="section">
        <div class="section-head">
          <span class="step-num">02</span>
          <h2>What I have built</h2>
        </div>
        <div class="work-grid">
          {work.map((w) => (
            <article class="work-card" data-rise="0">
              <div class="work-card__top">
                <span class="kicker">{w.kicker}</span>
                <span class="years">{w.years}</span>
              </div>
              <h3>{w.title}</h3>
              <p>{w.body}</p>
              <div class="tags">
                {w.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="evidence" class="section">
        <div class="section-head">
          <span class="step-num">03</span>
          <h2>Evidence</h2>
        </div>
        <div class="stats-grid" data-rise="0">
          {stats.map((s) => (
            <div class="stat">
              <div class="stat__n">{s.n}</div>
              <div class="stat__l">{s.l}</div>
            </div>
          ))}
        </div>

        <p class="journals-label">Published in</p>
        <div class="journals">
          {journals.map((j) => (
            <span class="journal">{j}</span>
          ))}
        </div>

        <h3 class="sub-head">Selected publications</h3>
        <p class="pubs-intro">
          The research record is where the standards come from — work on generalizability, negative sampling,
          disease representation, and how biological machine learning is measured. It is the same bar I hold
          products and vendors to.
        </p>
        <ol class="pubs-list">
          {pubs.map((p) => (
            <li class="pub" data-rise="0">
              <span class="pub__year">{p.year}</span>
              <div>
                <p class="pub__cite">
                  {p.cite} <em>{p.venue}</em>{p.tail}
                </p>
                <div class="pub__meta">
                  <span class="pub__tag">{p.tag}</span>
                  <a class="pub__link" href={p.href} target="_blank" rel="noopener">
                    {p.link}
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ol>
        <p class="pubs-more">
          Twenty papers in total — the full list is on <a href="https://scholar.google.com" target="_blank" rel="noopener">Google Scholar</a>.
        </p>
      </section>

      <section id="contact" class="section section--last">
        <div class="contact-card" data-rise="0">
          <h2>If you are deciding where AI belongs in your research organization, I am glad to think it through with you.</h2>
          <p>Advisory, board conversations, and talks. Boston-based, working globally.</p>
          <div class="cta-row">
            <a class="lf-btn lf-btn--primary lf-btn--lg" href="https://www.linkedin.com/in/CyrusRavandi" target="_blank" rel="noopener">
              Follow on LinkedIn
            </a>
            <a class="lf-btn lf-btn--ghost lf-btn--lg" href="mailto:cyrus@ravandi.ai">Email me</a>
          </div>
        </div>
        <div class="footer-row">
          <span>© 2026 Cyrus B. Ravandi, Ph.D.</span>
          <span class="footer-links">
            <a href="https://scholar.google.com" target="_blank" rel="noopener">Google Scholar</a>
            <a href="https://github.com/bravandi" target="_blank" rel="noopener">GitHub</a>
            <a href="https://www.linkedin.com/in/CyrusRavandi" target="_blank" rel="noopener">LinkedIn</a>
          </span>
        </div>
      </section>
    </div>
  </div>
</Base>

<script src="../scripts/emergence-story.js"></script>
<script>
  // Reveal-on-scroll for [data-rise] elements, ported from the design canvas.
  // The canvas also watches for DOM mutations (its runtime injects list items
  // client-side); this build renders everything statically at build time, so
  // a single sweep on load is enough — no MutationObserver needed.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('reveal-on');
    const rio = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('in');
          rio.unobserve(e.target);
        });
      },
      { rootMargin: '0px 0px -6% 0px', threshold: 0.05 },
    );
    document.querySelectorAll('[data-rise]').forEach((el) => {
      if (el.getBoundingClientRect().top < window.innerHeight * 0.94) el.classList.add('in');
      else rio.observe(el);
    });
  }
</script>

<style>
  .col {
    padding: 0 clamp(28px, 5vw, 76px);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 26px 0 0;
    position: sticky;
    top: 0;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    z-index: 5;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 20px;
  }

  .brand-dot {
    width: 11px;
    height: 11px;
    border-radius: 4px;
    background: var(--gradient-brand);
    box-shadow: 0 4px 12px rgba(201, 44, 106, 0.28);
  }

  .brand-name {
    font-size: 13px;
    font-weight: var(--fw-demibold);
    letter-spacing: 0.04em;
    color: var(--text-strong);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 22px;
    padding-bottom: 20px;
    font-size: 13px;
    color: var(--ink-600);
  }

  .site-nav a {
    color: inherit;
  }

  .hero {
    padding: clamp(40px, 7vh, 84px) 0 0;
  }

  .hero-top {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .avatar {
    position: relative;
    width: 104px;
    height: 104px;
    flex: none;
    border-radius: 50%;
    background: var(--gradient-soft);
    border: 1px solid var(--violet-100);
    box-shadow: 0 10px 26px rgba(109, 40, 217, 0.1);
    overflow: hidden;
  }

  .avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 8px;
    border: 1px solid var(--ink-200);
    border-radius: 999px;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-600);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--magenta-500);
  }

  h1 {
    margin: 22px 0 0;
    font-size: clamp(30px, 3.5vw, 46px);
    line-height: 1.12;
    letter-spacing: -0.028em;
    font-weight: var(--fw-extrabold);
    color: var(--ink-950);
    text-wrap: balance;
  }

  .grad-text {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lede {
    margin: 24px 0 0;
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.62;
    color: var(--text-body);
    max-width: 30em;
    text-wrap: pretty;
  }

  .cta,
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 32px 0 0;
  }

  .cta {
    gap: 10px;
  }

  .cta-row {
    gap: 12px;
  }

  /* The canvas's mobile fix for the hero buttons: shrink and force nowrap so
     "Follow on LinkedIn" and the email button fit side by side rather than
     wrapping to their own lines with an awkward gap between them. */
  @media (max-width: 600px) {
    .cta .lf-btn {
      height: 44px !important;
      padding: 0 16px !important;
      font-size: 14px !important;
      white-space: nowrap;
    }
  }

  .section {
    padding: clamp(64px, 10vh, 110px) 0 0;
  }

  .section--last {
    padding-bottom: clamp(48px, 8vh, 90px);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 30px;
  }

  .section-head--tight {
    margin-bottom: 12px;
  }

  .step-num {
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-400);
    font-variant-numeric: tabular-nums;
  }

  .section-head h2 {
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: var(--fw-bold);
    color: var(--text-strong);
  }

  .section-intro {
    margin: 0 0 8px;
    font-size: 15px;
    line-height: 1.62;
    color: var(--ink-600);
    max-width: 40em;
    text-wrap: pretty;
  }

  .sub-head {
    margin: clamp(46px, 7vh, 72px) 0 12px;
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: var(--fw-bold);
    color: var(--text-strong);
  }

  /* Point of view: deliberately un-carded. The work below is evidence and
     sits in boxes; this is argument and reads as a numbered list. */
  .pov-list {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    border-top: 1px solid var(--ink-150);
  }

  .pov {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 20px;
    padding: 26px 6px 26px 10px;
    border-bottom: 1px solid var(--ink-150);
    align-items: start;
    border-radius: 12px;
    transition: background 200ms ease, padding-left 220ms var(--ease-out);
  }

  .pov:hover {
    background: linear-gradient(90deg, var(--violet-50), rgba(255, 255, 255, 0));
    padding-left: 16px;
  }

  .pov__n {
    font-size: 12.5px;
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    padding-top: 4px;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pov__t {
    margin: 0;
    font-size: 18px;
    line-height: 1.34;
    letter-spacing: -0.012em;
    font-weight: var(--fw-demibold);
    color: var(--ink-950);
    text-wrap: balance;
  }

  .pov__b {
    margin: 9px 0 0;
    font-size: 15px;
    line-height: 1.64;
    color: var(--text-body);
    max-width: 44em;
    text-wrap: pretty;
  }

  @media (max-width: 600px) {
    .pov {
      grid-template-columns: 26px minmax(0, 1fr);
      gap: 12px;
      padding: 22px 2px;
    }

    .pov__t {
      font-size: 17px;
    }
  }

  .work-grid {
    display: grid;
    gap: 16px;
  }

  .work-card {
    border: 1px solid var(--ink-150);
    border-radius: 20px;
    padding: 26px;
    background: var(--white);
    box-shadow: 0 1px 2px rgba(20, 16, 31, 0.03);
    transition: transform 260ms var(--ease-out), box-shadow 260ms var(--ease-out), border-color 260ms;
  }

  .work-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 44px rgba(109, 40, 217, 0.11);
    border-color: var(--violet-200);
  }

  .work-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .kicker {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--violet-700);
    font-weight: var(--fw-bold);
  }

  .years {
    font-size: 11.5px;
    color: var(--ink-400);
    font-variant-numeric: tabular-nums;
  }

  .work-card h3 {
    margin: 12px 0 0;
    font-size: 21px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    font-weight: var(--fw-bold);
    color: var(--ink-950);
  }

  .work-card p {
    margin: 10px 0 0;
    font-size: 15px;
    line-height: 1.62;
    color: var(--text-body);
    text-wrap: pretty;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 0;
  }

  .tag {
    font-size: 11.5px;
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--violet-50);
    color: var(--violet-800);
    border: 1px solid var(--violet-100);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    background: var(--ink-150);
    border: 1px solid var(--ink-150);
    border-radius: 20px;
    overflow: hidden;
  }

  .stat {
    background: var(--white);
    padding: 24px 20px;
    transition: background 220ms ease;
  }

  .stat:hover {
    background: var(--violet-50);
  }

  .stat__n {
    font-size: 32px;
    font-weight: var(--fw-extrabold);
    letter-spacing: -0.035em;
    color: var(--ink-950);
    font-variant-numeric: tabular-nums;
  }

  .stat__l {
    margin-top: 6px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-600);
  }

  .journals-label {
    margin: 34px 0 14px;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-400);
  }

  .journals {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 15px;
    color: var(--text-strong);
  }

  .journal {
    font-weight: var(--fw-demibold);
  }

  .pubs-intro {
    margin: 0 0 26px;
    font-size: 15px;
    line-height: 1.62;
    color: var(--ink-600);
    max-width: 40em;
    text-wrap: pretty;
  }

  .pubs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .pub {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    gap: 20px;
    padding: 22px 6px 22px 10px;
    border-bottom: 1px solid var(--ink-150);
    align-items: start;
    border-radius: 12px;
    transition: background 200ms ease, padding-left 220ms var(--ease-out);
  }

  .pub:hover {
    background: linear-gradient(90deg, var(--violet-50), rgba(255, 255, 255, 0));
    padding-left: 16px;
  }

  .pub__year {
    font-size: 12.5px;
    color: var(--ink-400);
    font-variant-numeric: tabular-nums;
    padding-top: 3px;
  }

  .pub__cite {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-body);
    text-wrap: pretty;
  }

  .pub__cite em {
    color: var(--text-strong);
    font-style: normal;
  }

  .pub__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
  }

  .pub__tag {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: var(--fw-bold);
    color: var(--violet-700);
    padding: 4px 9px;
    border-radius: 6px;
    background: var(--violet-50);
  }

  .pub__link {
    font-size: 13px;
    color: var(--ink-500);
    border-bottom: 1px solid var(--border);
  }

